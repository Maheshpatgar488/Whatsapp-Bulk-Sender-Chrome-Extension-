{
  "manifest_version": 3,
  "name": "WhatsApp Business Bulk Sender",
  "version": "1.2.7",
  "update_url": "https://raw.githubusercontent.com/Maheshpatgar488/Whatsapp-Bulk-Sender-Chrome-Extension-/main/updates.xml",
  "description": "Send bulk personalized WhatsApp messages from Excel/CSV with placeholder tags, auto-delay pacing, and delivery export.",
  "browser_specific_settings": {
    "gecko": {
      "id": "whatsapp-bulk-sender@maheshpatgar.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://web.whatsapp.com/*",
    "https://web.whatsapp.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WhatsApp Bulk Sender"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
